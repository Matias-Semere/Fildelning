#!/usr/bin/env python3
import os
import sys

sys.path.insert(0, "/opt/fildelning")

from shares import (
    create_receive,
    load_receives,
    remove_receive
)

from file_utils import get_base_url


def usage():
    print("""
Usage:

  receive "/path/to/directory"
  receive list
  receive stop TOKEN
  receive stop-all
""")


def main():

    if len(sys.argv) < 2:
        usage()
        return 1

    command = sys.argv[1]

    if command == "stop-all":

        if len(sys.argv) != 2:
            usage()
            return 1

        receives = load_receives()
        tokens = list(receives.keys())

        if not tokens:
            print("Inga aktiva uppladdningslänkar.")
            return 0

        count = 0
        for token in tokens:
            if remove_receive(token):
                count += 1

        print(f"Stoppade {count} uppladdningslänkar.")
        return 0

    if command == "list":

        receives = load_receives()

        if not receives:
            print("Inga aktiva uppladdningslänkar.")
            return 0

        base_url = get_base_url()

        for token, data in receives.items():
            print()
            print("Token:")
            print(token)
            print("Directory:")
            print(data["directory"])
            print("URL:")
            print(f"{base_url}/r/{token}")

        print()
        return 0

    if command == "stop":

        if len(sys.argv) != 3:
            usage()
            return 1

        token = sys.argv[2]

        if remove_receive(token):
            print("Uppladdningslänk stoppad.")
            return 0

        print("Token hittades inte.")
        return 1

    directory = os.path.abspath(os.path.expanduser(command))

    if not os.path.isdir(directory):
        print(
            f"Fel: katalogen finns inte:\n"
            f"{directory}"
        )
        return 1

    token = create_receive(directory)
    base_url = get_base_url()

    print()
    print("Tar emot filer till:")
    print(directory)
    print()
    print("Uppladdningslänk:")
    print(f"{base_url}/r/{token}")
    print()
    print("Håll denna länk hemlig.")

    return 0


if __name__ == "__main__":
    sys.exit(main())